# ---- Email notifications for ALL website forms ----
# (Contact, Expression of Interest / Application, Postgraduate Application,
#  Entrepreneur Training Registration)
# Every submission is emailed to this address (default: chiekenn@gmail.com)
NOTIFICATION_EMAIL="chiekenn@gmail.com"

# SMTP credentials (required for emails to actually send).
# For Gmail: use your Gmail address as SMTP_USER and a Gmail App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords) as SMTP_PASS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Optional: customise the sender shown on the notification email
SMTP_FROM_NAME="UPEC Digital Campus"
# SMTP_FROM="notifications@yourdomain.com"

# ---- Database ----
# DATABASE_URL=""
